<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Identidade do app: fonte Nunito e cores do mar em todas as telas. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:colorPrimary">#0077B6</item>
        <item name="android:colorPrimaryDark">#0077B6</item>
        <item name="android:colorAccent">#00B4D8</item>
        <item name="android:colorControlActivated">#00B4D8</item>
        <item name="android:textColorHighlight">#5590E0EF</item>
        <item name="android:windowBackground">#FFE0F7FA</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">#0077B6</item>
        <item name="android:colorControlActivated">#00B4D8</item>
        <item name="android:textColorPrimary">#023E8A</item>
        <item name="android:textColorSecondary">#5C7C99</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
        <item name="android:windowTitleStyle">@style/AppDialogTitle</item>
    </style>

    <style name="AppDialogTitle">
        <item name="android:textAppearance">@android:style/TextAppearance.Material.DialogWindowTitle</item>
        <item name="android:fontFamily">@font/nunito_black</item>
        <item name="android:textColor">#023E8A</item>
        <item name="android:textSize">21sp</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="AppDialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
